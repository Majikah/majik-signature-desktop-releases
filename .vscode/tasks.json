{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Majik Signature: Publish Release",
      "type": "shell",
      "command": "npm",
      "args": ["run", "package:all", "--", "${input:releaseVersion}"],
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "releaseVersion",
      "type": "promptString",
      "description": "Majik Signature version",
      "default": "0.17.0"
    }
  ]
}
