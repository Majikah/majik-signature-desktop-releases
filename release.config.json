{
    "repository": "Majikah/majik-signature-desktop-releases",
    "productName": "Majik Signature",
    "sourceRepository": "Majikah/majik-signature-desktop",
    "platforms": {
        "windows": {
            "enabled": true,
            "requiredExtensions": [
                ".exe",
                ".msix",
                ".msi"
            ]
        },
        "linux": {
            "enabled": true,
            "requiredExtensions": [
                ".deb",
                ".AppImage",
                ".rpm",
                ".snap"
            ]
        },
        "macos": {
            "enabled": false,
            "requiredExtensions": [
                ".dmg"
            ]
        }
    },
    "sbom": {
        "enabled": true,
        "cwd": "../majik-signature-desktop",
        "format": "spdx",
        "type": "application",
        "filename": "SBOM.spdx.json"
    },
    "signing": {
        "enabled": true,
        "keyPathEnv": "MAJIK_RELEASE_KEY_PATH",
        "passphraseEnv": "MAJIK_RELEASE_KEY_PASSPHRASE",
        "outputFilename": "MAJIK-SIGNATURE.mjksmap"
    }
}